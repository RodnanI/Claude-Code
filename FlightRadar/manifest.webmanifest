{
  "name": "SQUAWK Live Flight Radar",
  "short_name": "SQUAWK",
  "description": "Live air traffic from free ADS-B networks with 3D airspace, radar scope, sky view and alerts.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#040504",
